{
  "name": "docx-anonymizer",
  "version": "0.3.0",
  "description": "Браузерное расширение: локальная анонимизация .docx и PDF перед загрузкой в LLM-сервисы",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "build:e2e": "node scripts/build.mjs --e2e",
    "pack": "node scripts/pack.mjs",
    "pack:model": "node scripts/pack-model.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/build.mjs --e2e && playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "sample": "node scripts/make-sample.mjs",
    "gen-fixtures": "node scripts/gen-fixtures.mjs",
    "gen-pdf-fixtures": "node scripts/gen-pdf-fixtures.mjs",
    "gen-ner-eval": "node scripts/gen-ner-eval.mjs",
    "gen-genre-fixtures": "node scripts/gen-genre-fixtures.mjs",
    "eval-genres": "node scripts/eval-genres.mjs",
    "bench-ner": "node scripts/bench-ner.mjs",
    "dicts": "node scripts/make-dicts.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "onnxruntime-web": "1.30.0",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "hyparquet": "1.31.2",
    "prettier": "3.9.9",
    "vitest": "5.0.3"
  }
}
