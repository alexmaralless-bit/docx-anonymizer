{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docx-anonymizer.local/schemas/protocol.schema.json",
  "title": "Протокол клиент ⇄ ядро (ТЗ §5.4 + расширение ACK)",
  "description": "Каждое сообщение — объект с полем type; схема сообщения — $defs/<type>. Корневая схема принимает любое из них.",
  "oneOf": [
    { "$ref": "#/$defs/FILE_BEGIN" },
    { "$ref": "#/$defs/FILE_CHUNK" },
    { "$ref": "#/$defs/ANALYZE" },
    { "$ref": "#/$defs/GET_TEXT" },
    { "$ref": "#/$defs/ADD_ENTITY" },
    { "$ref": "#/$defs/APPLY" },
    { "$ref": "#/$defs/CANCEL" },
    { "$ref": "#/$defs/DISCARD" },
    { "$ref": "#/$defs/LIST_SESSIONS" },
    { "$ref": "#/$defs/DEANON" },
    { "$ref": "#/$defs/GET_MAPPING" },
    { "$ref": "#/$defs/BATCH_BEGIN" },
    { "$ref": "#/$defs/BATCH_END" },
    { "$ref": "#/$defs/CATALOG_CHANGED" },
    { "$ref": "#/$defs/MODEL_CHANGED" },
    { "$ref": "#/$defs/MODEL_BOOTSTRAP" },
    { "$ref": "#/$defs/OPEN_OPTIONS" },
    { "$ref": "#/$defs/MODEL_INSTALL" },
    { "$ref": "#/$defs/MODEL_INSTALLED" },
    { "$ref": "#/$defs/PROGRESS" },
    { "$ref": "#/$defs/ENTITIES" },
    { "$ref": "#/$defs/TEXT" },
    { "$ref": "#/$defs/RESULT_BEGIN" },
    { "$ref": "#/$defs/RESULT_CHUNK" },
    { "$ref": "#/$defs/RESULT_END" },
    { "$ref": "#/$defs/ERROR" },
    { "$ref": "#/$defs/SESSIONS" },
    { "$ref": "#/$defs/DEANON_RESULT" },
    { "$ref": "#/$defs/MAPPING" },
    { "$ref": "#/$defs/ACK" }
  ],
  "$defs": {
    "requestId": { "type": "string", "minLength": 1 },
    "base64": { "type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$" },
    "stage": { "enum": ["receiving", "unzip", "parse", "pdf", "detect", "ner", "kb", "apply", "zip", "sending"] },
    "errorCode": {
      "enum": [
        "NOT_DOCX",
        "ENCRYPTED",
        "TOO_LARGE",
        "PARSE_FAILED",
        "HOST_UNAVAILABLE",
        "MODEL_LOAD_FAILED",
        "PDF_INVALID",
        "PDF_ENCRYPTED",
        "PDF_EMPTY",
        "PDF_NO_TEXT",
        "INTERNAL"
      ]
    },

    "FILE_BEGIN": {
      "type": "object",
      "required": ["type", "requestId", "size", "chunks", "name"],
      "properties": {
        "type": { "const": "FILE_BEGIN" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "name": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 0 },
        "chunks": { "type": "integer", "minimum": 1 },
        "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "origin": { "type": ["string", "null"] }
      }
    },
    "FILE_CHUNK": {
      "type": "object",
      "required": ["type", "requestId", "index", "data"],
      "properties": {
        "type": { "const": "FILE_CHUNK" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "index": { "type": "integer", "minimum": 0 },
        "data": { "$ref": "#/$defs/base64" }
      }
    },
    "ANALYZE": {
      "type": "object",
      "required": ["type", "requestId"],
      "properties": {
        "type": { "const": "ANALYZE" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "settingsOverride": { "type": "object" },
        "batchId": { "type": ["string", "null"] }
      }
    },
    "GET_TEXT": {
      "type": "object",
      "required": ["type", "requestId", "docId"],
      "properties": {
        "type": { "const": "GET_TEXT" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "docId": { "type": "string" },
        "part": { "type": "string" },
        "from": { "type": "integer", "minimum": 0 },
        "count": { "type": "integer", "minimum": 1 }
      }
    },
    "ADD_ENTITY": {
      "type": "object",
      "required": ["type", "requestId", "docId", "category", "text"],
      "properties": {
        "type": { "const": "ADD_ENTITY" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "docId": { "type": "string" },
        "category": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "replaceAll": { "type": "boolean" },
        "streamId": { "type": "string" },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 }
      }
    },
    "decision": {
      "type": "object",
      "required": ["entityId", "action"],
      "properties": {
        "entityId": { "type": "string" },
        "action": { "enum": ["replace", "skip"] },
        "replacement": { "type": "string" },
        "excludedOccurrences": { "type": "array", "items": { "type": "string" } }
      }
    },
    "APPLY": {
      "type": "object",
      "required": ["type", "requestId", "docId"],
      "properties": {
        "type": { "const": "APPLY" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "docId": { "type": "string" },
        "mode": { "enum": ["placeholder", "mask", "delete"] },
        "decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
        "options": {
          "type": "object",
          "properties": { "keepMetadata": { "type": "boolean" }, "stripEmbedded": { "type": "boolean" } }
        }
      }
    },
    "CANCEL": {
      "type": "object",
      "required": ["type", "requestId"],
      "properties": { "type": { "const": "CANCEL" }, "requestId": { "$ref": "#/$defs/requestId" } }
    },
    "DISCARD": {
      "type": "object",
      "required": ["type", "requestId", "docId"],
      "properties": { "type": { "const": "DISCARD" }, "requestId": { "$ref": "#/$defs/requestId" }, "docId": { "type": "string" } }
    },
    "LIST_SESSIONS": {
      "type": "object",
      "required": ["type", "requestId"],
      "properties": { "type": { "const": "LIST_SESSIONS" }, "requestId": { "$ref": "#/$defs/requestId" } }
    },
    "DEANON": {
      "type": "object",
      "required": ["type", "requestId", "mappingRef", "text"],
      "properties": {
        "type": { "const": "DEANON" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "mappingRef": { "oneOf": [{ "type": "string" }, { "$ref": "mapping.schema.json" }] },
        "text": { "type": "string" },
        "decline": { "type": "boolean" }
      }
    },
    "GET_MAPPING": {
      "type": "object",
      "required": ["type", "requestId", "docId"],
      "properties": { "type": { "const": "GET_MAPPING" }, "requestId": { "$ref": "#/$defs/requestId" }, "docId": { "type": "string", "minLength": 1 } }
    },
    "BATCH_BEGIN": {
      "type": "object",
      "required": ["type", "requestId", "batchId"],
      "properties": { "type": { "const": "BATCH_BEGIN" }, "requestId": { "$ref": "#/$defs/requestId" }, "batchId": { "type": "string", "minLength": 1 } }
    },
    "BATCH_END": {
      "type": "object",
      "required": ["type", "requestId"],
      "properties": { "type": { "const": "BATCH_END" }, "requestId": { "$ref": "#/$defs/requestId" }, "batchId": { "type": "string" } }
    },
    "CATALOG_CHANGED": {
      "type": "object",
      "required": ["type", "requestId"],
      "properties": { "type": { "const": "CATALOG_CHANGED" }, "requestId": { "$ref": "#/$defs/requestId" } }
    },
    "MODEL_CHANGED": {
      "type": "object",
      "description": "Пакет модели NER установлен или удалён (WP8): хост сбрасывает кэш провайдера. Ответ — ACK.",
      "required": ["type", "requestId"],
      "properties": {
        "type": { "const": "MODEL_CHANGED" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "modelId": { "type": "string", "pattern": "^([a-z0-9][a-z0-9-]{1,40})?$" }
      }
    },
    "MODEL_BOOTSTRAP": {
      "type": "object",
      "description": "Поставить встроенный пакет модели заново (WP10-C, кнопка «Восстановить встроенную модель»). Клиент → background, ответ — ACK сразу; установка идёт в фоне.",
      "required": ["type", "requestId"],
      "properties": { "type": { "const": "MODEL_BOOTSTRAP" }, "requestId": { "$ref": "#/$defs/requestId" } }
    },
    "OPEN_OPTIONS": {
      "type": "object",
      "description": "Открыть страницу настроек на разделе (0.4, ссылка в подсказке панели о политике маскирования). Клиент → background, ответ — ACK; вкладка options.html#<section>.",
      "required": ["type", "requestId", "section"],
      "properties": {
        "type": { "const": "OPEN_OPTIONS" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "section": { "enum": ["categories", "companies", "ner"] }
      }
    },
    "MODEL_INSTALL": {
      "type": "object",
      "description": "Background → offscreen (clientId 'bootstrap', WP10-C): установить пакет модели из архива расширения (chrome-extension://…/models/<file>). Ответ — MODEL_INSTALLED.",
      "required": ["type", "requestId", "url", "id", "sha256"],
      "properties": {
        "type": { "const": "MODEL_INSTALL" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "url": { "type": "string", "pattern": "^chrome-extension://" },
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,40}$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "version": { "type": "string" },
        "extensionVersion": { "type": "string" }
      }
    },
    "MODEL_INSTALLED": {
      "type": "object",
      "description": "Итог MODEL_INSTALL (WP10-C): installed — записан в OPFS, present — уже стоит тот же sha, failed — не установлен (code — ModelStoreError, UNVERIFIED или MISMATCH).",
      "required": ["type", "requestId", "status", "id", "sha256"],
      "properties": {
        "type": { "const": "MODEL_INSTALLED" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "status": { "enum": ["installed", "present", "failed"] },
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,40}$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "version": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 0 },
        "ms": { "type": "number", "minimum": 0 },
        "code": { "type": "string", "pattern": "^[A-Z_]+$" }
      }
    },

    "PROGRESS": {
      "type": "object",
      "required": ["type", "requestId", "stage", "percent"],
      "properties": {
        "type": { "const": "PROGRESS" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "stage": { "$ref": "#/$defs/stage" },
        "percent": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "occurrence": {
      "type": "object",
      "required": ["id", "part", "streamId", "start", "end", "text", "context"],
      "properties": {
        "id": { "type": "string" },
        "part": { "type": "string" },
        "pid": { "type": ["string", "integer", "null"] },
        "streamId": { "type": "string" },
        "stream": {},
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 },
        "text": { "type": "string", "minLength": 1 },
        "context": { "type": "string" },
        "variantOf": { "type": ["string", "null"] }
      }
    },
    "entity": {
      "type": "object",
      "required": ["id", "category", "value", "normalized", "placeholder", "level", "source", "enabled", "occurrences"],
      "properties": {
        "id": { "type": "string", "pattern": "^e\\d+$" },
        "category": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "normalized": { "type": "string" },
        "placeholder": { "type": "string", "minLength": 1 },
        "replacement": { "type": ["string", "null"] },
        "level": { "enum": ["validated", "labeled", "kb", "ner", "weak"] },
        "source": { "enum": ["rule", "label", "kb", "user", "ner", "list"] },
        "validated": { "type": ["string", "null"] },
        "enabled": { "type": "boolean" },
        "occurrences": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/occurrence" } }
      }
    },
    "ENTITIES": {
      "type": "object",
      "required": ["type", "requestId", "docId", "name", "language", "placeholderLanguage", "entities", "warnings", "stats", "restoredDecisions"],
      "properties": {
        "type": { "const": "ENTITIES" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "docId": { "type": "string", "pattern": "^d\\d+$" },
        "name": { "type": "string" },
        "kind": { "enum": ["docx", "pdf"] },
        "language": { "enum": ["ru", "en", "both"] },
        "placeholderLanguage": { "enum": ["ru", "en"] },
        "entities": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code"],
            "properties": { "code": { "type": "string", "pattern": "^[A-Z_]+$" }, "count": { "type": "integer" }, "details": { "type": "object" } }
          }
        },
        "stats": {
          "type": "object",
          "required": ["virtualTextLength", "entities", "occurrences"],
          "properties": {
            "virtualTextLength": { "type": "integer", "minimum": 0 },
            "entities": { "type": "integer", "minimum": 0 },
            "occurrences": { "type": "integer", "minimum": 0 }
          }
        },
        "restoredDecisions": { "type": "boolean" }
      }
    },
    "TEXT": {
      "type": "object",
      "required": ["type", "requestId", "docId", "paragraphs", "total"],
      "properties": {
        "type": { "const": "TEXT" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "docId": { "type": "string" },
        "paragraphs": {
          "type": "array",
          "items": { "type": "object", "required": ["pid", "text", "spans"], "properties": { "text": { "type": "string" }, "spans": { "type": "array" } } }
        },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "RESULT_BEGIN": {
      "type": "object",
      "required": ["type", "requestId", "name", "size", "chunks", "docId"],
      "properties": {
        "type": { "const": "RESULT_BEGIN" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "name": { "type": "string", "pattern": "\\.(docx|docm|md|txt)$" },
        "mime": { "type": "string", "pattern": "^[a-z]+/[a-z0-9.+-]+$" },
        "size": { "type": "integer", "minimum": 1 },
        "chunks": { "type": "integer", "minimum": 1 },
        "docId": { "type": "string" }
      }
    },
    "RESULT_CHUNK": {
      "type": "object",
      "required": ["type", "requestId", "index", "data"],
      "properties": {
        "type": { "const": "RESULT_CHUNK" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "index": { "type": "integer", "minimum": 0 },
        "data": { "$ref": "#/$defs/base64" }
      }
    },
    "RESULT_END": {
      "type": "object",
      "required": ["type", "requestId", "docId", "mapping", "stats"],
      "properties": {
        "type": { "const": "RESULT_END" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "docId": { "type": "string" },
        "mapping": { "$ref": "mapping.schema.json" },
        "stats": {
          "type": "object",
          "required": ["replacements", "entities", "changedParts", "removedParts"],
          "properties": {
            "replacements": { "type": "integer", "minimum": 0 },
            "entities": { "type": "integer", "minimum": 0 },
            "changedParts": { "type": "array", "items": { "type": "string" } },
            "removedParts": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "ERROR": {
      "type": "object",
      "required": ["type", "requestId", "code", "message"],
      "properties": {
        "type": { "const": "ERROR" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "code": { "$ref": "#/$defs/errorCode" },
        "message": { "type": "string", "minLength": 1 },
        "details": {},
        "reason": { "enum": ["NO_SESSION", "NO_MAPPING"] }
      }
    },
    "SESSIONS": {
      "type": "object",
      "required": ["type", "requestId", "sessions"],
      "properties": {
        "type": { "const": "SESSIONS" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "sessions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["docId", "name", "sha256", "createdAt", "entities"],
            "additionalProperties": false,
            "properties": {
              "docId": { "type": "string" },
              "name": { "type": "string" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "createdAt": { "type": "integer" },
              "origin": { "type": ["string", "null"] },
              "entities": { "type": "integer", "minimum": 0 },
              "replacements": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "DEANON_RESULT": {
      "type": "object",
      "required": ["type", "requestId", "text", "unresolved", "replaced"],
      "properties": {
        "type": { "const": "DEANON_RESULT" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "text": { "type": "string" },
        "unresolved": { "type": "array", "items": { "type": "object", "required": ["text"], "properties": { "text": { "type": "string" } } } },
        "replaced": { "type": "integer", "minimum": 0 },
        "declined": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["start", "end", "case", "original", "text"],
            "properties": {
              "start": { "type": "integer", "minimum": 0 },
              "end": { "type": "integer", "minimum": 0 },
              "case": { "enum": ["nom", "gen", "dat", "acc", "ins", "prep"] },
              "original": { "type": "string" },
              "text": { "type": "string" }
            }
          }
        }
      }
    },
    "MAPPING": {
      "type": "object",
      "required": ["type", "requestId", "docId", "mapping"],
      "properties": {
        "type": { "const": "MAPPING" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "docId": { "type": "string" },
        "mapping": { "$ref": "mapping.schema.json" }
      }
    },
    "ACK": {
      "type": "object",
      "required": ["type", "requestId"],
      "properties": { "type": { "const": "ACK" }, "requestId": { "$ref": "#/$defs/requestId" }, "batchId": { "type": "string" } }
    }
  }
}
